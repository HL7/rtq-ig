Instance: questionnaireresponse-ID001-round2
InstanceOf: QuestionnaireResponse
Title: "Response SP-RTQ-2025-0163 to Question Set ID001-R2"
Description: "Round 2 response in the example thread. Answers only the questions left open in ID001-R2 (product-3 and the two quality-4 follow-up questions); questions marked resolved need no answer. Offers a new commitment on quality-4.2."
Usage: #example
* meta.versionId = "1"
* meta.lastUpdated = "2025-12-19T16:00:00Z"
* meta.profile = "http://hl7.org/fhir/uv/rtq/StructureDefinition/rtq-questionnaireresponse"
* extension[RtqResponseVersionExtension].valueString = "1.0"
* extension[RtqProcedureIdentifierExtension].valueIdentifier.system = "https://example-nra.example.org/procedure-number"
* extension[RtqProcedureIdentifierExtension].valueIdentifier.value = "NRA/H/C/005432/II/0023"
* identifier[+].system = "http://hl7.org/fhir/uv/brr/identifier/qa-request"
* identifier[=].value = "ID001-R2"
* identifier[=].type = $rtq-identifier-type#regulator-id "Regulator-issued Identifier"
* identifier[+].system = "https://synthpharma.example/identifier/rtq-response"
* identifier[=].value = "SP-RTQ-2025-0163"
* identifier[=].type = $rtq-identifier-type#company-id "Company-issued Identifier"
* contained[0] = org-mah
* questionnaire = "Questionnaire/questionnaire-ID001-round2"
* status = #completed
* subject = Reference(MedicinalProductDefinition/MedicinalProduct-ExampleDrug) "ExampleDrug 10 mg Tablets"
* author.type = "Organization"
* author = Reference(org-mah) "SynthPharma AG"
* source.type = "Organization"
* source = Reference(org-mah) "SynthPharma AG"
* authored = "2025-12-19T15:00:00+01:00"
* item[+].linkId = "product-3"
* item[=].text = "Is the updated ePI text sufficiently clear for all applicable languages?"
* item[=].answer[+].valueString = "Apologies for the omission. The approved French and German ePI texts (linguistic review completed 2025-12-12) are now included in the response package alongside the English text."
* item[=].answer[=].extension[+].url = "http://hl7.org/fhir/StructureDefinition/rendering-xhtml"
* item[=].answer[=].extension[=].valueString = "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>Apologies for the omission. The approved French and German ePI texts (linguistic review completed 2025-12-12) are now included in the response package alongside the English text.</p></div>"
* item[+].linkId = "quality-4"
* item[=].text = "Are there any new degradation products identified within the newly submitted data?"
* item[=].item[+].linkId = "quality-4.1"
* item[=].item[=].text = "The chromatograms for batch B-002 at 6 months accelerated (40°C/75% RH) show an unidentified peak at RRT 0.85 at 0.12%, above the 0.10% identification threshold. Identify this degradation product and propose a specification limit."
* item[=].item[=].answer[+].valueString = "The peak at RRT 0.85 is the N-oxide of the active substance, identified by LC-MS and confirmed against a synthesized reference standard. It forms only under accelerated conditions in the Alu/Alu pack. Proposed shelf-life limit: NMT 0.15%."
* item[=].item[=].answer[=].extension[+].url = "http://hl7.org/fhir/StructureDefinition/rendering-xhtml"
* item[=].item[=].answer[=].extension[=].valueString = "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>The peak at RRT 0.85 is the N-oxide of the active substance, identified by LC-MS and confirmed against a synthesized reference standard. It forms only under accelerated conditions in the Alu/Alu pack. Proposed shelf-life limit: NMT 0.15%.</p></div>"
* item[=].item[+].linkId = "quality-4.2"
* item[=].item[=].text = "Provide the toxicological qualification of this degradation product per ICH Q3B(R2), or justify why qualification is not required."
* item[=].item[=].answer[+].valueString = "The N-oxide is a major human metabolite, so it is qualified at the proposed limit of 0.15% per ICH Q3B(R2). To confirm this, SynthPharma commits to a 13-week repeat-dose toxicity study on the isolated N-oxide."
* item[=].item[=].answer[=].extension[+].url = "http://hl7.org/fhir/StructureDefinition/rendering-xhtml"
* item[=].item[=].answer[=].extension[=].valueString = "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p>The N-oxide is a major human metabolite, so it is qualified at the proposed limit of 0.15% per ICH Q3B(R2). To confirm this, SynthPharma commits to a 13-week repeat-dose toxicity study on the isolated N-oxide.</p></div>"
* item[=].item[=].extension[RtqCommitmentExtension].extension[description].valueMarkdown = "Complete a 13-week repeat-dose toxicity study on the isolated N-oxide degradation product and submit the study report."
* item[=].item[=].extension[RtqCommitmentExtension].extension[dueDate].valueDate = "2026-09-30"
